# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Write .env by piping values, never by echoing a secret into your shell first.
# See _build/DECISIONS.md D-010 for the exact command.

# Test-mode secret key. From the Stripe CLI after `stripe login`.
STRIPE_SECRET_KEY=sk_test_...

# TWO DIFFERENT WEBHOOK SECRETS. They are not interchangeable, and confusing
# them is the most common way to lose an afternoon on this project.

# Local development. From: stripe listen --print-secret
# Backs every locally signed payload in stages 04a and 04b.
STRIPE_WEBHOOK_SECRET_CLI=whsec_...

# Deployed Render endpoint. From the Stripe dashboard webhook settings,
# available only after stage 01 deploys. Leave empty until then.
STRIPE_WEBHOOK_SECRET_DASHBOARD=

# Gates GET /test/payments/{id}. Must be false anywhere public.
TESTING=false
